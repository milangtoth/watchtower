# Model credentials are passed at runtime. Provide the key through private hand-in.
# Provider: anthropic (recommended, used for the latest live runs), openai or deepseek.
# The code defaults to openai when this is unset, so set it explicitly.
WATCHTOWER_MODEL_PROVIDER=anthropic
# Key for the chosen provider. Only the one that matches the provider is read.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# Model ID for the provider, with structured outputs support.
WATCHTOWER_MODEL=claude-sonnet-5-5
# Optional: model calls in flight at once across all portals. Defaults to 6.
# WATCHTOWER_MODEL_CONCURRENCY=6
# Optional: override the provider's API endpoint.
# WATCHTOWER_MODEL_URL=
# Optional ElevenAgents voice assistant credentials.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# Mounted path inside the container.
WATCHTOWER_DATA_DIR=/data
WATCHTOWER_READ_INTERVAL=900
# Optional: portals worked on at once. Defaults to 32.
# WATCHTOWER_CONCURRENCY=32
# Optional service log level.
RUST_LOG=info
