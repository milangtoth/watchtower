# Model key: name it in the README and hand the value in at submission
ANTHROPIC_API_KEY=
# Model used to learn, check and repair portal recipes
WATCHTOWER_MODEL=claude-sonnet-5-5
# Where SQLite and downloaded documents live inside the container
WATCHTOWER_DATA_DIR=/data
# Seconds between scheduled reads of each portal
WATCHTOWER_READ_INTERVAL=900
